+# proto-message: ServiceBundleConfig
+
+# Service bundle FQIN with instance.
+package_name: "com.android.sdv.sample.gapb"
+service_bundle_name: "AirbagTester"
+instance: "instance"
+
+# Connect into the VM auto_start group

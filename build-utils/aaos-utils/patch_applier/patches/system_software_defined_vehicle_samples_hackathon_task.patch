+//! Shared library implementing 'AirbagTester' service bundle logic.
+#![allow(unused_imports)]
+
+use log::{debug, error, info, warn};
+use sdv::mw::clientlib::create_publisher;
+use sdv::mw::SdvComms;
+use someip_messages_catalog::vehicledata::TellTaleStatus;
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::time::sleep;
+use tokio_util::sync::CancellationToken;
+
+sdv::lifecycle::register_service_bundle!(AirbagTesterServiceBundle);
+
+struct AirbagTesterServiceBundle {
+    cancellation_token: Option<CancellationToken>,
+    context: ContextRef,
+}
+
+impl ServiceBundle for AirbagTesterServiceBundle {
+    fn new(context: ContextRef) -> Self {
+        if let Err(err) = sdv::tracing::try_init_tracing() {
+            warn!("Failed to init service bundles tracing: {err}");
+        }
+        Self { cancellation_token: None, context }
+    }
+
+    fn on_start(&mut self) {
+        debug!("on_start called for AirbagTester service bundle...");
+        let context = self.context;
+        let cancellation_token = CancellationToken::new();
+        self.cancellation_token = Some(cancellation_token.clone());
+        let Ok(runtime) =
+            tokio::runtime::Builder::new_current_thread().enable_time().enable_io().build()
+        else {
+            panic!("Failed to start the runtime!");
+        };
+        debug!("spawning thread for AirbagTester service bundle...");
+        let _ = std::thread::spawn(move || {
+            runtime.block_on(async move {
+                let comms = Arc::new(SdvComms { context });
+                debug!("Calling sdv_main for AirbagTester...");
+                let res = tokio::select! {
+                    res = sdv_main(comms) => res,
+                    () = cancellation_token.cancelled() => {
+                        Err(sdv::status::SdvStatus::new(sdv::status::SdvStatusCode::Cancelled))
+                    }
+                };
+                error!("AirbagTester service bundle loop stopped: {res:?}.");
+            });
+            drop(runtime);
+        });
+    }
+
+    fn on_stop(&mut self) {
+        if let Some(token) = self.cancellation_token.take() {
+            token.cancel();
+        }
+    }
+}
+
+#[allow(unused_variables,unused_mut,unreachable_code)]
+async fn sdv_main(comms: Arc<SdvComms>) -> sdv::status::SdvResult<()> {
+    info!("Starting service bundle 'AirbagTester'");
+
+    let publisher = create_publisher(
+        comms.as_ref(),
+        sdv_mw_rs_com_android_sdv_sample_gapb_airbag_tester::PublisherDescriptors::<
+            TellTaleStatus,
+        >::AIRBAG,
+    )
+    .await?;
+
+    info!("Airbag publisher created successfully in AirbagTester");
+
+    let mut telltale_alert = false;
+    // loop {
+    //     sleep(Duration::from_secs(5)).await;
+    //     telltale_alert = !telltale_alert;
+
+    //     let mut status = TellTaleStatus::new();
+    //     status.alert = telltale_alert;
+
+    //     info!("AirbagTester publishing TellTaleStatus for airbag: alert={telltale_alert}");
+    //     if let Err(e) = publisher.publish(&status) {
+    //         warn!("Failed to publish airbag TellTaleStatus: {e:?}");
+    //     }
+    // }
+    Ok(())
+}

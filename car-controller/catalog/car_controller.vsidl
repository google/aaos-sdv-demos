# proto-file: system/software_defined_vehicle/vsidl/language/src/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "com.android.sdv.sample.gapb"

service_bundle {
  name: "CarController"

  # Light Logic
  # Subscribe to vehicle sensors (fog and ambient light) and calculate
  # a threshold until the lights have to be turned on and the UI switched to dark mode.
  subscriber {
    message: "com.android.sdv.someip.CarlaAmbientFog"
    topic: "carla-ambient-fog"
  }

  publisher {
    message: "com.android.sdv.someip.CarlaAmbientFog"
    topic: "carla-ambient-fog"
    capacity: 8
  }

  subscriber {
    message: "com.android.sdv.someip.CarlaAmbientLight"
    topic: "carla-ambient-light"
  }

  publisher {
    message: "com.android.sdv.someip.CarlaAmbientLight"
    topic: "carla-ambient-light"
    capacity: 8
  }

  publisher {
    message: "com.android.sdv.sample.vsidl_vhal_proxy_integration.NightMode"
    topic: "vhal-night-mode"
    capacity: 8
  }

  publisher {
    message: "com.android.sdv.someip.LightCommand"
    topic: "light-command"
    capacity: 8
  }

  # Range Logic
  # Subscribe to the overall distance traveled and subtract tht from the overall
  # battery capacity. When a signal of recharging arrives, the battery is back to full.
  # Given the battery state, we'll publish the range remaining.
  subscriber {
    message: "RechargeCommand"
    topic: "recharge-command"
  }

  publisher {
    message: "RechargeCommand"
    topic: "recharge-command"
    capacity: 8
  }

  subscriber {
    message: "com.android.sdv.someip.CarlaVehicleOdometer"
    topic: "odometer-reading"
  }

  publisher {
    message: "com.android.sdv.someip.CarlaVehicleOdometer"
    topic: "odometer-reading"
    capacity: 8
  }

  publisher {
    message: "com.sdv.google.display_safety.RangeRemaining"
    topic: "range-remaining"
    capacity: 8
  }

}

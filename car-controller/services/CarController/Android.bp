package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_ffi_shared {
    name: "libsdv_lm_car_controller",
    srcs: ["src/main.rs"],
    defaults: [
        "sdv_tracing@rust_defaults",
    ],
    crate_name: "sdv_lm_car_controller",
    product_specific: true,
    rustlibs: [
        "libtap",
        "libtokio",
        "libtokio_util",
        "libtokio_stream",
        "libanyhow",
        "libfutures",
        "libfutures_util",
        "libsdv_rs",
        "libsdv_mw_rs_com_android_sdv_sample_gapb_car_controller",
        "liblog_rust",
        "libprotobuf",
        "libsomeip_messages_catalog",
        "liboem_harry_vehicle_messages_catalog_v1",
        "libcar_controller_proto",
        "libvhal_proxy_catalog",
        "libsdv_status_rs",
        "librand",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    min_sdk_version: "35",
}

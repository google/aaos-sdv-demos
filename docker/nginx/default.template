server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_tokens off;
    absolute_redirect off;

    # Security headers inherited from the parent cicd-foundation configuration
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location = / {
        return 302 /selkies/;
    }

    location = /healthz {
        return 200 "OK";
        # nginx discards every inherited add_header as soon as a nested block
        # declares one of its own, so the server-level security headers above
        # have to be repeated here.
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Type text/plain always;
        add_header App-Status "READY" always;
    }

    location /selkies/ {
        proxy_pass http://127.0.0.1:8081/selkies/;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Forward the real client hostname. Selkies guards the streaming
        # WebSocket against cross-site hijacking by comparing the browser's
        # Origin against the Host it receives, matching on hostname alone when
        # Host carries no port.
        #
        # $host is NOT that hostname here: the Cloud Workstations front-end
        # rewrites Host to "localhost" and moves the browser's hostname into
        # X-Forwarded-Host. $sdv_forwarded_host recovers it - see
        # conf.d/10-selkies-forwarded-host.conf for why this keeps the origin
        # check meaningful instead of defeating it.
        proxy_set_header Host              $sdv_forwarded_host;
        proxy_set_header X-Forwarded-Host  $sdv_forwarded_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        tcp_nodelay on;
    }
}

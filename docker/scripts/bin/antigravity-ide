# ==============================================================================
# Detached X11 launcher for Antigravity IDE.
#
# Ensures DISPLAY, XDG_RUNTIME_DIR, D-Bus session bus, and ADC auth environment
# variables are populated even when invoked from non-desktop shells or systemd,
# and detaches the Electron process from the controlling terminal.
#
# Window placement (left 40% width x 100% height) is enforced natively by
# Openbox via /etc/xdg/openbox/rc.xml.
# ==============================================================================

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"
export DISPLAY="${DISPLAY:-:0}"
export AGY_ADC_AUTH="${AGY_ADC_AUTH:-true}"

setsid /opt/Antigravity-x64/antigravity \
  --no-sandbox \
  --ozone-platform=x11 \
  --password-store=basic \
  --disable-gpu-sandbox \
  --disable-dev-shm-usage \
  "$@" >/dev/null 2>&1 </dev/null &

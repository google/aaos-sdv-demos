# ==============================================================================
# Full-file override of the cicd-foundation `android-studio-for-platform` layer's
# ASfP wrapper (apps/workstations/android-studio-for-platform/assets/usr/local/bin/asfp-studio).
#
# This image runs X11, not the inherited GNOME Wayland session, so this drops
# upstream's Wayland toolkit backends and its wait_for_monitor(), which polls a
# masked Mutter and always burns its full 60s timeout.
#
# Keep in sync with upstream when bumping the base image ref in skaffold.yaml.
# ==============================================================================

set -euo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}"
export DISPLAY="${DISPLAY:-:0}"

exec /opt/android-studio-for-platform-canary/bin/studio "$@"

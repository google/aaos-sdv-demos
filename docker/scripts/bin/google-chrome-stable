# ==============================================================================
# Full-file override of the cicd-foundation `gnome` layer's Chrome wrapper
# (apps/workstations/gnome/assets/usr/local/bin/google-chrome-stable).
#
# Only difference from upstream: upstream forces --ozone-platform=wayland for its
# headless GNOME Wayland session. This image runs a plain X11 desktop (Xtigervnc
# on :0 with openbox), so Chrome is pointed at the X11 Ozone backend instead.
#
# Keep in sync with upstream when bumping the base image ref in skaffold.yaml.
# ==============================================================================

# shellcheck disable=SC1091

set -euo pipefail

# Source common utilities for WORKSTATION_GPU_ENABLED
# shellcheck source=apps/workstations/common/assets/google/scripts/common.sh
source /google/scripts/common.sh

CHROME_FLAGS=(
  "--no-sandbox"
  "--test-type"
  "--no-first-run"
  "--no-default-browser-check"
  "--disable-dev-shm-usage"
  "--password-store=basic"
)

# Apply stability flags for the headless X11 session.
CHROME_FLAGS+=(
  "--ozone-platform=x11"
)

if [[ "${WORKSTATION_GPU_ENABLED}" == "false" ]]; then
  CHROME_FLAGS+=(
    "--disable-gpu"
    "--disable-gpu-compositing"
    "--in-process-gpu"
    "--disable-gpu-sandbox"
  )
fi

exec /usr/bin/google-chrome-stable.real "${CHROME_FLAGS[@]}" "$@"

# Initial Antigravity IDE window snapped to the left 40% of the desktop via
# Openbox application rules (/etc/xdg/openbox/rc.xml).
#
# Restart=no and Type=oneshot: /usr/local/bin/antigravity-ide spawns the IDE
# detached, and if the user closes the window it should stay closed.
#
# No [Install] section on purpose: activation comes from sdv-desktop.target.

[Unit]
Description=SDV initial Antigravity IDE window
Requires=sdv-openbox.service
After=sdv-openbox.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=user
WorkingDirectory=/home/user
PAMName=systemd-user
Environment=DISPLAY=:0
Environment=LANG=en_US.UTF-8
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=AGY_ADC_AUTH=true
ExecStart=/usr/local/bin/antigravity-ide
Restart=no

# Single activation point for the desktop stack. Pulled into multi-user.target by
# docker/scripts/workstation-startup.d/015_optimize-remote-desktop.sh, which
# rewrites 20-desktop.conf before /sbin/init runs.
#
# The member services carry no [Install] section deliberately. The base image's
# configure_workstation.sh symlinks every /etc/systemd/system/*.service that has
# one into multi-user.target.wants/, which would start them directly and bypass
# the ordering declared here. That loop only globs *.service, so this target is
# never auto-enabled - hence 015 naming it explicitly.

[Unit]
Description=SDV remote desktop stack
Wants=sdv-xserver.service sdv-openbox.service sdv-panel.service sdv-selkies.service sdv-antigravity.service sdv-terminal.service sdv-host-orchestrator.service

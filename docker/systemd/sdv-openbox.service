# Window manager. Stock openbox defaults - this image ships no rc.xml and no
# menu.xml, so the Debian root menu (right-click) is what you get.
#
# No [Install] section on purpose: activation comes from sdv-desktop.target.

[Unit]
Description=SDV window manager (openbox)
Requires=sdv-xserver.service
After=sdv-xserver.service

[Service]
Type=simple
User=user
PAMName=systemd-user
Environment=DISPLAY=:0
Environment=LANG=en_US.UTF-8
ExecStart=/usr/bin/openbox
ExecStartPost=-/usr/bin/xsetroot -solid "#A1BE95"
Restart=always
RestartSec=2

# Panel. Invoked bare, with no -c: tint2 writes its own default tint2rc on first
# run and shows a taskbar, clock and systray. This image ships no tint2rc.
#
# No [Install] section on purpose: activation comes from sdv-desktop.target.

[Unit]
Description=SDV panel (tint2)
Requires=sdv-openbox.service
After=sdv-openbox.service

[Service]
Type=simple
User=user
PAMName=systemd-user
Environment=DISPLAY=:0
Environment=LANG=en_US.UTF-8
ExecStart=/usr/bin/tint2
Restart=always
RestartSec=2

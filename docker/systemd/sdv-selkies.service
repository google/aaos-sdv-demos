# Capture and encode: Selkies takes the :0 framebuffer over XShm and encodes it
# with NVENC (via pixelflux), serving the stream on 127.0.0.1:8081 for nginx to
# reverse-proxy. The encoder choice is made at runtime by the launcher.
#
# No [Install] section on purpose: activation comes from sdv-desktop.target.

[Unit]
Description=SDV desktop streaming (Selkies, NVENC H.264)
Requires=sdv-xserver.service
After=sdv-xserver.service

[Service]
Type=simple
User=user
PAMName=systemd-user
Environment=DISPLAY=:0
Environment=LANG=en_US.UTF-8
ExecStart=/usr/local/bin/sdv-selkies-launch
Restart=always
RestartSec=2
